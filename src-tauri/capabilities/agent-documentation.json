{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "agent-documentation",
  "description": "允许主窗口使用默认浏览器打开四个 Agent 的官方配置文档和安装说明",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://developers.openai.com/codex/config-basic/"
        },
        {
          "url": "https://code.claude.com/docs/en/settings"
        },
        {
          "url": "https://geminicli.com/docs/reference/configuration/"
        },
        {
          "url": "https://docs.x.ai/build/settings"
        },
        {
          "url": "https://developers.openai.com/codex/cli/"
        },
        {
          "url": "https://code.claude.com/docs/en/quickstart"
        },
        {
          "url": "https://geminicli.com/docs/get-started/installation/"
        },
        {
          "url": "https://docs.x.ai/build/overview#install"
        }
      ]
    }
  ]
}
